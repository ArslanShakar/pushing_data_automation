
def clean_dict(data, columns_dict=None):
    for key in data or {}:
        try:
            if [e in key.lower() for e in skipped_fields]:
                continue

            if columns_dict and 'int' in columns_dict.get(key, ''):
                data[key] = int(data[key] or 0) if data[key] else 0
                continue

            if isinstance(data[key], str) and 'varchar' in data.get(key, '') or 'text' in data.get(key, ''):
                if key == "schedule":
                    data[key] = data[key].replace("\u201C", '"')
                elif key in ['state']:
                    data[key] = clean(data[key]).upper()
                elif key == 'address':
                    data[key] = parse_address(data[key])
                elif key == 'price':
                    data[key] = clean_price(data[key])
                else:
                    data[key] = clean(data[key])
        except Exception as e:
            print(f"Exception in clean_dict: {e}")
            a = 0

    return data